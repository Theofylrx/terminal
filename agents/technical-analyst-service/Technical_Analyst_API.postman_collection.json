			"description": "Comprehensive Elliott Wave pattern detection with all 9 pattern types from the handbook"
		},
		{
			"name": "Divergences",
			"item": [
				{
					"name": "Detect RSI Divergences",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/divergences/{{symbol}}?timeframe={{timeframe}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"divergences",
								"{{symbol}}"
							],
							"query": [
								{
									"key": "timeframe",
									"value": "{{timeframe}}"
								}
							]
						},
