		},
		{
			"name": "Smart Money Concepts",
			"item": [
				{
					"name": "Detect Smart Money Patterns",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/smart-money/{{symbol}}?timeframe={{timeframe}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"smart-money",
								"{{symbol}}"
							],
							"query": [
								{
									"key": "timeframe",
									"value": "{{timeframe}}"
								}
							]
						},
						"description": "Detect all 14 institutional trading patterns:\n\n**Core Patterns (6):**\n- BOS (Break of Structure) - Trend continuation signals\n- CHoCH (Change of Character) - Trend reversal signals\n- FVG (Fair Value Gap) - Price imbalances\n- Supply/Demand Zones - Institutional S/R areas\n- Order Blocks - Institutional entry zones\n- Liquidity Sweeps (BSL/SSL) - Stop hunts\n\n**Advanced Patterns (8):**\n- EQH/EQL (Equal Highs/Lows) - Liquidity pools at same price levels\n- Order Flow (OF) - General institutional zones before trend changes\n- IFC (Institutional Funding Candle) - Reversal candles that sweep and close back\n- FBOS (False Break of Structure) - False signals that trap retail traders\n- Session Liquidity - Asia/London/NY session high/low sweeps\n- Daily Liquidity (PDH/PDL, PWH/PWL) - Previous Day/Week high/low levels\n- SMT (Smart Money Trap) - First pullback traps after major moves\n- IDM (Inducement) - Small moves that trap retail before reversals\n\n**Complete institutional-grade Smart Money Concepts implementation as per official handbook.**"
					},
					"response": []
				}
			],
			"description": "Smart Money Concepts - Complete 14-Pattern Implementation (BOS, CHoCH, FVG, Supply/Demand, Order Blocks, Liquidity Sweeps, EQH/EQL, Order Flow, IFC, FBOS, Session Liquidity, PDH/PDL, SMT, IDM)"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default variables if not set",
					"if (!pm.variables.get('base_url')) {",
					"    pm.variables.set('base_url', 'http://localhost:8000/api/v1');",
					"}",
					"if (!pm.variables.get('symbol')) {",
					"    pm.variables.set('symbol', 'AAPL');",
					"}",
					"if (!pm.variables.get('timeframe')) {",
					"    pm.variables.set('timeframe', '1h');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Common tests for all endpoints",
					"pm.test('Status code is 2xx', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
					"});",
					"",
					"pm.test('Response time is less than 5000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"pm.test('Content-Type is JSON', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"});"
				]
			}
		}
	]
}
