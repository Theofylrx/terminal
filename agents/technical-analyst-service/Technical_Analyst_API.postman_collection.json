{
	"info": {
		"_postman_id": "technical-analyst-api-v2",
		"name": "Technical Analyst Service API",
		"description": "Enterprise-grade technical analysis service providing institutional-quality trading signals with Elliott Wave, RSI Divergence, and Smart Money Concepts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "terminal-ai"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "symbol",
			"value": "AAPL",
			"type": "string"
		},
		{
			"key": "timeframe",
			"value": "1h",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Check if the Technical Analyst Service is running and healthy"
					},
					"response": []
				}
			],
			"description": "Health check endpoints"
		},
		{
			"name": "Signals",
			"item": [
				{
					"name": "Generate Signal",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"timeframe\": \"{{timeframe}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/signals/generate",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"signals",
								"generate"
							]
						},
						"description": "Generate a high-confidence trading signal using all 15 indicators, 10+ patterns, Elliott Wave, RSI divergences, and Smart Money Concepts."
					},
					"response": []
				},
				{
					"name": "Get All Signals",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/signals?limit=100",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"signals"
							],
							"query": [
								{
									"key": "limit",
									"value": "100"
								},
								{
									"key": "symbol",
									"value": "{{symbol}}",
									"disabled": true
								},
								{
									"key": "status",
									"value": "ACTIVE",
									"disabled": true
								}
							]
						},
						"description": "Retrieve all trading signals with optional filters"
					},
					"response": []
				},
				{
					"name": "Get Signal by Symbol",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/signals?symbol={{symbol}}&limit=50",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"signals"
							],
							"query": [
								{
									"key": "symbol",
									"value": "{{symbol}}"
								},
								{
									"key": "limit",
									"value": "50"
								}
							]
						},
						"description": "Get signals filtered by symbol"
					},
					"response": []
				},
				{
					"name": "Get Active Signals",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/signals?status=ACTIVE&limit=100",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"signals"
							],
							"query": [
								{
									"key": "status",
									"value": "ACTIVE"
								},
								{
									"key": "limit",
									"value": "100"
								}
							]
						},
						"description": "Get only active signals"
					},
					"response": []
				},
				{
					"name": "Get Signal by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/signals/:signal_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"signals",
								":signal_id"
							],
							"variable": [
								{
									"key": "signal_id",
									"value": "replace-with-signal-id"
								}
							]
						},
						"description": "Retrieve a specific signal by its ID"
					},
					"response": []
				}
			],
			"description": "Trading signal generation and management"
		},
		{
			"name": "Indicators",
			"item": [
				{
					"name": "Get Technical Indicators",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/indicators/{{symbol}}?timeframe={{timeframe}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"indicators",
								"{{symbol}}"
							],
							"query": [
								{
									"key": "timeframe",
									"value": "{{timeframe}}"
								}
							]
						},
						"description": "Calculate and return all 15 technical indicators (RSI, MACD, Bollinger Bands, EMAs, ATR, etc.)"
					},
					"response": []
				}
			],
			"description": "Technical indicator calculations"
		},
