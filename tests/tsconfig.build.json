{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": [
    "lib/**/*",
    "pages/**/*",
    "fixtures/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-results",
    "specs/**/*",
    "**/*.spec.ts"
  ]
}
