# Terminal Trading System - Environment Variables
# Copy this file to .env and fill in your values

# ==================== DATABASE ====================
DATABASE_URL=postgresql://trading_user:your_password@postgres:5432/terminal_db
DB_PASSWORD=your_secure_password_here
POSTGRES_USER=trading_user
POSTGRES_DB=terminal_db

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=  # Leave empty for no password

# ==================== RABBITMQ (Alternative to Redis Streams) ====================
RABBITMQ_URL=amqp://trading:your_password@rabbitmq:5672/
RABBITMQ_USER=trading
RABBITMQ_PASSWORD=your_secure_password

# ==================== AUTHENTICATION ====================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ==================== MARKET DATA SERVICE ====================
ENABLE_ALPACA=false  # Enable Alpaca stock data connector
ENABLE_BINANCE=false  # Enable Binance crypto data connector
ENABLE_OANDA=false  # Enable OANDA forex data connector

# ==================== BROKERS - STOCKS (ALPACA) ====================
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets  # Live trading (CAUTION!)
ALPACA_PAPER=true

# ==================== BROKERS - CRYPTO (BINANCE) ====================
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_secret_key
BINANCE_TESTNET=true  # Use testnet (recommended)
# BINANCE_TESTNET=false  # Live trading (CAUTION!)

# ==================== BROKERS - FOREX (OANDA) ====================
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_PRACTICE=true  # Practice account
# OANDA_PRACTICE=false  # Live account (CAUTION!)

# ==================== NEWS & DATA APIS ====================
FINNHUB_API_KEY=your_finnhub_api_key
NEWS_API_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_alphavantage_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token  # Optional
REDDIT_CLIENT_ID=your_reddit_client_id  # Optional
REDDIT_CLIENT_SECRET=your_reddit_client_secret  # Optional

# ==================== NOTIFICATION SERVICES ====================
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=Terminal Trading <noreply@terminal.com>

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==================== MONITORING ====================
GRAFANA_PASSWORD=admin  # Change in production
PROMETHEUS_RETENTION_DAYS=15

# ==================== APPLICATION SETTINGS ====================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG=true

# API Gateway
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# Service URLs (for local development)
AUTH_SERVICE_URL=http://auth-service:8000
TRADING_SERVICE_URL=http://trading-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000
STRATEGY_SERVICE_URL=http://strategy-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# ==================== RISK MANAGEMENT ====================
# Maximum risk per trade (percentage)
MAX_RISK_PER_TRADE=2.0

# Maximum daily loss (percentage)
MAX_DAILY_LOSS=5.0

# Maximum drawdown before system pause (percentage)
MAX_DRAWDOWN=20.0

# Maximum correlation between positions
MAX_POSITION_CORRELATION=0.7

# Maximum number of concurrent positions
MAX_CONCURRENT_POSITIONS=10

# Position sizing method: fixed_fractional, kelly_criterion, atr_based
POSITION_SIZING_METHOD=fixed_fractional

# ==================== STRATEGY SETTINGS ====================
# Default strategy
DEFAULT_STRATEGY=ma_crossover

# Enable paper trading first
PAPER_TRADING=true

# Timeframes to monitor (comma-separated)
TIMEFRAMES=1m,5m,15m,1h,4h,1D

# ==================== BACKTESTING ====================
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000

# ==================== CORS (Frontend) ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# ==================== FEATURE FLAGS ====================
ENABLE_FUNDAMENTAL_ANALYSIS=true
ENABLE_TECHNICAL_ANALYSIS=true
ENABLE_AUTO_TRADING=false  # Set to true to enable automatic trading
ENABLE_NOTIFICATIONS=true
